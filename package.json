{
  "name": "blackarcanum",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-pagefind.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test:services-seo": "node scripts/test-services-seo-build.mjs",
    "test:services-home": "node scripts/test-services-home.mjs",
    "test:services-navigation": "node scripts/test-services-navigation-browser.mjs",
    "test:practitioner": "node scripts/test-practitioner-pages.mjs",
    "test:services-details": "node scripts/test-services-details.mjs",
    "test:services-filter": "node scripts/test-services-sphere-pages.mjs --filters",
    "test:services-spheres": "node scripts/test-services-sphere-pages.mjs",
    "test:services-hub": "node scripts/test-services-hub.mjs",
    "test:services-cards": "node scripts/test-services-cards.mjs",
    "test:services-presentation": "node --experimental-strip-types scripts/test-services-presentation.mjs",
    "test:content": "node --experimental-strip-types scripts/test-editorial-schema.mjs",
    "test:editorial": "node --experimental-strip-types scripts/test-editorial-qa.mjs",
    "qa:units": "node --experimental-strip-types scripts/run-unit-tests.mjs && npm run test:newsletter",
    "qa:content": "npm run qa:units && npm run build && npm run test:samples",
    "qa:fast": "npm run qa:content && npm run typecheck && npm audit --audit-level=high",
    "test:grimoire": "node --experimental-strip-types scripts/test-grimoire-archive.mjs",
    "test:article-routes": "node scripts/test-article-reading-fixtures.mjs",
    "test:article-responsive": "node scripts/test-article-reading-browser.mjs",
    "test:toc": "node --experimental-strip-types scripts/test-article-toc.mjs",
    "test:references": "node --experimental-strip-types scripts/test-article-references.mjs",
    "test:related": "node --experimental-strip-types scripts/test-editorial-related.mjs",
    "test:media": "node --experimental-strip-types scripts/test-media-registry.mjs",
    "test:media-display": "node --experimental-strip-types scripts/test-media-display.mjs",
    "test:media-render-fixtures": "node scripts/test-media-render-fixtures.mjs",
    "test:media-render-browser": "node scripts/test-media-render-browser.mjs",
    "test:media-files": "node --experimental-strip-types scripts/test-media-files.mjs",
    "test:media-build": "node scripts/test-media-build.mjs",
    "test:related-fixtures": "node scripts/test-editorial-related-fixtures.mjs",
    "test:related-browser": "node scripts/test-editorial-related-browser.mjs",
    "test:references-fixtures": "node scripts/test-article-references-fixtures.mjs",
    "test:references-browser": "node scripts/test-article-references-browser.mjs",
    "test:samples": "node scripts/test-sample-articles.mjs",
    "test:seo-build": "node scripts/test-seo-build.mjs",
    "test:toc-fixtures": "node scripts/test-article-toc-fixtures.mjs",
    "test:toc-browser": "node scripts/test-article-toc-browser.mjs",
    "test:archive": "node --experimental-strip-types scripts/test-editorial-archive.mjs",
    "test:presentation": "node --experimental-strip-types scripts/test-editorial-presentation.mjs",
    "test:pagefind-build": "node scripts/test-pagefind-build.mjs",
    "test:search-browser": "node scripts/test-search-browser.mjs",
    "test:newsletter": "node scripts/test-newsletter.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.5",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.1",
    "@starwind-ui/astro": "^1.4.0",
    "@tabler/icons": "^3.50.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "svelte": "^5.57.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "@astrojs/vercel": "^11.0.16"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "pagefind": "1.5.2"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
