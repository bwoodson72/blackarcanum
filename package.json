    "test:grimoire": "node --experimental-strip-types scripts/test-grimoire-archive.mjs",
    "test:article-routes": "node scripts/test-article-reading-fixtures.mjs",
    "test:article-responsive": "node scripts/test-article-reading-browser.mjs",
    "test:archive": "node --experimental-strip-types scripts/test-editorial-archive.mjs",
    "test:presentation": "node --experimental-strip-types scripts/test-editorial-presentation.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.5",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.1",
    "@starwind-ui/astro": "^1.4.0",
    "@tabler/icons": "^3.50.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "svelte": "^5.57.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "@astrojs/vercel": "^11.0.16"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12"
  },
