---
import BaseLayout from "../layouts/BaseLayout.astro";
import { checkEditorialBuild } from "../lib/editorial-build-qa";

// Every production build validates all editorial references and curated IDs.
// The homepage stays a noindex project shell until its own implementation step.
await checkEditorialBuild();
---

<BaseLayout noindex>
  <section aria-labelledby="site-title" class="mx-auto max-w-reading px-gutter py-section">
    <h1 id="site-title">Mystagogia</h1>
    <p class="mt-4 text-text-muted">Editorial site in development.</p>
  </section>
</BaseLayout>
