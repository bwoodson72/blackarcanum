---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/foundation/Container.astro";
import Ornament from "../components/foundation/Ornament.astro";
import PageHero from "../components/site/PageHero.astro";
import EngravedFrame from "../components/foundation/EngravedFrame.astro";
import ArticleGrid from "../components/editorial/ArticleGrid.astro";
import NewsletterSection from "../components/site/NewsletterSection.astro";
import { checkEditorialBuild } from "../lib/editorial-build-qa";
import { getPublishedLibraryEntries, getPublishedGrimoireEntry } from "../lib/editorial-public";
import { toPublishedArticle } from "../lib/editorial-presentation";
import "../styles/homepage.css";

export const prerender = true;

// The homepage uses only explicitly curated IDs, never newest-article fallback.
const selected = await checkEditorialBuild();
const libraryEntries = await getPublishedLibraryEntries();
const libraryById = new Map(libraryEntries.map((entry) => [entry.id, entry]));
const featuredLibrary = (selected.homepageLibrary ?? []).map(({ id }) => {
  const entry = libraryById.get(id);
  if (!entry) throw new Error('Homepage Library feature not published: ' + id);
  const article = toPublishedArticle({ collection: "library", entry });
  if (!article) throw new Error('Homepage feature not cleared: ' + id);
  return article;
});
const spotlightEntry = selected.primaryGrimoire
  ? await getPublishedGrimoireEntry(selected.primaryGrimoire.id)
  : undefined;
if (selected.primaryGrimoire && !spotlightEntry) {
  throw new Error("Homepage Grimoire spotlight is not published.");
}
const spotlight = spotlightEntry
  ? toPublishedArticle({ collection: "grimoire", entry: spotlightEntry })
  : undefined;
const launched = featuredLibrary.some((article) => !article.preview) ||
  (spotlight !== undefined && !spotlight.preview);
---

<BaseLayout
  title="Mystagogia"
  description="Discover the hidden arts through historical sources, living traditions, and original practical exploration."
  noindex={!launched}
>
  <PageHero
    mode="home"
    titleId="home-title"
    title="Mystagogia"
    tagline={["Historical Research", "Practical Wisdom", "Living Tradition"]}
    description="Explore the crossroads of history, mythology, and magical practice. Mystagogia brings together rigorous research and practical wisdom for a modern return to the ancient ways."
    artSrc="/images/homepage/mystagogia-editorial-atlas.avif"
    actions={[
      { label: "Enter the Library", href: "/library/", icon: "book" },
      { label: "Enter the Grimoire", href: "/grimoire/", icon: "botanical" },
    ]}
  />

  <section class="home-paths" aria-labelledby="home-paths-heading">
    <Container width="wide">
      <div class="home-section-heading home-section-heading--center">
        <Ornament variant="rule" />
        <h2 id="home-paths-heading">Two Paths of Exploration</h2>
        <Ornament variant="rule" />
      </div>
      <div class="home-paths__grid">
        <article class="home-path">
          <a class="home-path__link" href="/library/" aria-labelledby="home-library-title">
            <span class="home-path__art home-path__art--library" aria-hidden="true">
              <svg class="home-path__image" viewBox="0 800 667 256" preserveAspectRatio="xMidYMid slice" focusable="false" aria-hidden="true">
                <image href="/images/homepage/mystagogia-editorial-atlas.avif" x="0" y="0" width="2000" height="1056" />
              </svg>
            </span>
            <div class="home-path__body">
              <div class="home-path__copy">
                <h3 id="home-library-title">The Library</h3>
                <span class="home-path__tagline">Historical Sources <span aria-hidden="true">·</span> Academic Research <span aria-hidden="true">·</span> Cultural Context</span>
              </div>
              <span class="home-path__arrow" aria-hidden="true">→</span>
            </div>
            <EngravedFrame />
          </a>
        </article>
        <article class="home-path">
          <a class="home-path__link" href="/grimoire/" aria-labelledby="home-grimoire-title">
            <span class="home-path__art home-path__art--grimoire" aria-hidden="true">
              <svg class="home-path__image" viewBox="667 800 666 256" preserveAspectRatio="xMidYMid slice" focusable="false" aria-hidden="true">
                <image href="/images/homepage/mystagogia-editorial-atlas.avif" x="0" y="0" width="2000" height="1056" />
              </svg>
            </span>
            <div class="home-path__body">
              <div class="home-path__copy">
                <h3 id="home-grimoire-title">The Grimoire</h3>
                <span class="home-path__tagline">Ritual Practice <span aria-hidden="true">·</span> Techniques <span aria-hidden="true">·</span> Personal Work</span>
              </div>
              <span class="home-path__arrow" aria-hidden="true">→</span>
            </div>
            <EngravedFrame />
          </a>
        </article>
      </div>
    </Container>
  </section>

  <section class="home-research" aria-labelledby="home-research-heading">
    <Container width="wide">
      <div class="home-section-heading home-section-heading--split">
        <div>
          <p class="home-eyebrow">From the Library</p>
          <h2 id="home-research-heading">Featured Research</h2>
        </div>
        <a class="home-text-link" href="/library/">View the Library <span aria-hidden="true">→</span></a>
      </div>
      {featuredLibrary.length > 0 ? (
        <ArticleGrid articles={featuredLibrary} headingLevel="h3" />
      ) : (
        <div class="home-research__empty" data-home-features-empty>
          <span class="home-research__mark" aria-hidden="true">✧</span>
          <div>
            <h3>Research worth returning to.</h3>
            <p>
              The featured shelf is reserved for selected, source-led work.
              Explore the Library to see the current archive and its clearly labeled layout previews.
            </p>
          </div>
          <a class="home-text-link" href="/library/">Visit the research archive <span aria-hidden="true">→</span></a>
        </div>
      )}
    </Container>
  </section>

  <section class="home-practice" aria-labelledby="home-practice-heading">
    <Container width="wide" class="home-practice__inner">
      <div class="home-practice__art" aria-hidden="true">
        <svg class="home-practice__image" viewBox="1333 800 667 256" preserveAspectRatio="xMidYMid slice" focusable="false" aria-hidden="true">
              <image href="/images/homepage/mystagogia-editorial-atlas.avif" x="0" y="0" width="2000" height="1056" />
            </svg>
        <EngravedFrame />
      </div>
      <div class="home-practice__copy">
        <p class="home-eyebrow">From the Grimoire</p>
        {spotlight ? (
          <>
            <h2 id="home-practice-heading">{spotlight.title}</h2>
            {spotlight.preview && <p class="home-practice__preview">Layout preview — not a finished account</p>}
            {spotlight.excerpt && <p>{spotlight.excerpt}</p>}
            <a class="home-text-link home-text-link--gold" href={spotlight.href}>
              Read the selected entry <span aria-hidden="true">→</span>
            </a>
          </>
        ) : (
          <>
            <h2 id="home-practice-heading">Inquiry becomes practice.</h2>
            <p>
              The Grimoire is devoted to methods, experiments, and careful observation.
              Its spotlight is selected deliberately, not filled automatically from the latest entry.
            </p>
            <a class="home-text-link home-text-link--gold" href="/grimoire/">
              Enter the Grimoire <span aria-hidden="true">→</span>
            </a>
          </>
        )}
      </div>
      <div class="home-practice__aside">
        <p class="home-eyebrow">Explore further</p>
        <p>Techniques, firsthand accounts, and the ideas connecting practice to historical sources.</p>
        <a class="home-text-link home-text-link--gold" href="/grimoire/">All Grimoire entries <span aria-hidden="true">→</span></a>
      </div>
    </Container>
  </section>

  <NewsletterSection />
</BaseLayout>
