---
/** Compact engraved CTA shared by every PageHero, with optional inline icon. */
import EngravedFrame from "../foundation/EngravedFrame.astro";
import "../../styles/hero-action.css";

interface Props {
  label: string;
  href: string;
  icon?: "book" | "botanical";
}
const { label, href, icon } = Astro.props;
---
<a class="hero-action" href={href}>
  <EngravedFrame />
  {icon === "book" ? (
    <svg class="hero-action__icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M16 25.5c-3-2.4-7.4-3.7-12-3.2V6.5c5-.3 9 1 12 3.2 3-2.2 7-3.5 12-3.2v15.8c-4.6-.5-9 0.8-12 3.2Z" />
      <path d="M16 9.7v15.8M7.4 10.5c2.2.1 3.9.7 5.4 1.6M24.6 10.5c-2.2.1-3.9.7-5.4 1.6" />
    </svg>
  ) : icon === "botanical" ? (
    <svg class="hero-action__icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M16 27V5M16 10c-4.7 0-6.8-2.9-6.7-5.2 4.1 0 6.7 2.4 6.7 5.2Zm0 5.5c4.9 0 7.2-3.2 7-5.5-4.3.1-7 2.5-7 5.5Zm0 5.3c-4.4 0-6.7-3.3-6.6-5.4 4.1 0 6.6 2.6 6.6 5.4Zm0 4.2c4.5 0 6.6-3.1 6.5-5.1-4 .1-6.5 2.5-6.5 5.1Z" />
      <path d="M11.5 27h9" />
    </svg>
  ) : null}
  <span class="hero-action__label">{label}</span>
  <span class="hero-action__arrow" aria-hidden="true">→</span>
</a>
