---
import MediaImage from "@/components/media/MediaImage.astro";
import { resolveMediaAsset } from "@/lib/media-assets";
import { media } from "@/data/media";
import { getMediaRecord, mediaPublicationIssues } from "@/lib/media-registry";

interface Props {
  id: string;
  kind: "article" | "reference" | "wide";
  /** Optional contextual caption for editorial art only. */
  caption?: string;
  lightbox?: boolean;
  /** Slot-accurate image sizes for gallery/comparison columns. */
  sizes?: string;
}
const { id, kind, caption, lightbox = false, sizes } = Astro.props;
if (typeof lightbox !== "boolean" || (lightbox && kind !== "reference")) {
  throw new Error("Lightbox is only supported for reference figures.");
}
const record = getMediaRecord(id, media);
const expectedRole = kind === "reference" ? "reference" : "editorial";
if (record.role !== expectedRole) {
  throw new Error(`${kind} figure "${id}" requires an approved ${expectedRole} image.`);
}
const issues = mediaPublicationIssues(record);
if (issues.length) {
  throw new Error(`Figure "${id}" is not cleared for publication: ${issues.join("; ")}.`);
}
if (caption !== undefined && (!caption.trim() || kind === "reference")) {
  throw new Error(`Figure "${id}": a caption override must be nonempty and is not allowed for reference figures.`);
}
const captionText = kind === "reference" ? record.caption : caption ?? record.caption;
if (kind === "reference" && !captionText?.trim()) {
  throw new Error(`Reference figure "${id}" requires the registry's verified caption.`);
}
const imageSizes = sizes ?? (kind === "wide"
  ? "(min-width: 1440px) 720px, (min-width: 1024px) min(960px, calc(100vw - 40px)), (min-width: 760px) 720px, calc(100vw - 40px)"
  : kind === "reference"
    ? "(max-width: 359px) calc(100vw - 40px), 320px"
    : undefined);
const provenance = [
  record.creator,
  record.date || record.period,
  record.repository,
].filter((value): value is string => !!value?.trim());
const originalAsset = lightbox ? resolveMediaAsset(record) : undefined;
---

<figure class:list={["mdx-figure", `mdx-figure--${kind}`]} data-mdx-figure={kind}>
  <MediaImage
    id={id}
    variant={kind === "reference" ? "reference" : "hero"}
    priority={false}
    sizes={imageSizes}
  />
  {originalAsset && (
    <button
      type="button"
      class="mdx-figure__expand"
      data-reference-lightbox-open
      aria-label={`Enlarge reference image: ${captionText}`}
      hidden
    >Enlarge image</button>
  )}
  <figcaption class="mdx-figure__caption">
    {captionText && <span class="mdx-figure__description">{captionText}</span>}
    {kind === "reference" && (
      <span class="mdx-figure__origin">
        {record.origin === "historical-reproduction" ? "Historical reproduction" : "Modern reference illustration"}
      </span>
    )}
    {kind === "reference" && provenance.length > 0 && (
      <span class="mdx-figure__provenance">{provenance.join(" · ")}</span>
    )}
    {kind === "reference" && record.sourceUrl && (
      <a href={record.sourceUrl} rel="noopener noreferrer">Source record</a>
    )}
    {originalAsset && (
      <a href={originalAsset.src} target="_blank" rel="noopener noreferrer">View original image</a>
    )}
    <span class="mdx-figure__credit">{record.rights.creditLine}</span>
    {kind === "reference" && record.rights.license && (
      <span class="mdx-figure__rights">{record.rights.license}</span>
    )}
    {kind === "reference" && record.rights.evidenceUrl && (
      <a href={record.rights.evidenceUrl} rel="noopener noreferrer">Reuse terms</a>
    )}
  </figcaption>
</figure>
{originalAsset && (
  <dialog
    class="mdx-reference-dialog"
    data-reference-lightbox
    aria-label={`Enlarged reference image: ${captionText}`}
  >
    <div class="mdx-reference-dialog__toolbar">
      <button type="button" class="mdx-reference-dialog__close" data-reference-lightbox-close>
        Close enlarged image
      </button>
    </div>
    <img
      class="mdx-reference-dialog__image"
      src={originalAsset.src}
      alt={record.alt}
      width={originalAsset.width}
      height={originalAsset.height}
      loading="lazy"
      decoding="async"
    />
    <p class="mdx-reference-dialog__caption">{captionText}</p>
    <a class="mdx-reference-dialog__original" href={originalAsset.src} target="_blank" rel="noopener noreferrer">
      View original image in new tab
    </a>
  </dialog>
)}

<style>
  .mdx-figure {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin-block: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-border-paper);
    border-radius: var(--radius-card);
    background: var(--color-aged-paper);
    overflow: hidden;
    break-inside: avoid;
  }
  /* Compact inline reference previews; the lightbox retains the full image. */
  .mdx-figure--reference :global(.media-picture--reference) {
    max-width: min(100%, var(--container-reference-inline));
    margin-inline: auto;
  }
  .mdx-figure--reference :global(.media-picture--reference img) {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: var(--container-reference-inline);
    margin-inline: auto;
    object-fit: contain;
  }
  .mdx-figure__caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.85rem;
    padding: 0.75rem clamp(0.75rem, 2vw, 1.25rem);
    border-top: 1px solid var(--color-border-paper);
    font-family: var(--font-interface), sans-serif;
    font-size: var(--text-ui);
    line-height: 1.55;
    color: var(--color-muted-ink);
    overflow-wrap: anywhere;
  }
  .mdx-figure__description {
    flex-basis: 100%;
    color: var(--color-charcoal);
    font-family: var(--font-reading), serif;
    font-size: 1.05em;
    line-height: 1.5;
  }
  .mdx-figure__origin,
  .mdx-figure__provenance,
  .mdx-figure__rights,
  .mdx-figure__credit {
    display: inline-block;
  }
  .mdx-figure__origin { font-weight: 650; color: var(--color-sage-ink); }
  .mdx-figure__rights { flex-basis: 100%; }
  .mdx-figure__caption a {
    color: var(--color-oxide-red);
    text-decoration: underline;
    text-underline-offset: 0.17em;
  }
  .mdx-figure__caption a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
    border-radius: var(--radius-control);
  }
  .mdx-figure__expand {
    display: block;
    margin: 0.7rem 1rem 0.7rem auto;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-antique-gold);
    border-radius: var(--radius-control);
    background: var(--color-parchment);
    color: var(--color-charcoal);
    font: 600 var(--text-ui) / 1.4 var(--font-interface);
    cursor: pointer;
  }
  .mdx-figure__expand[hidden] { display: none; }
  .mdx-figure__expand:hover { text-decoration: underline; }
  .mdx-figure__expand:focus-visible,
  .mdx-reference-dialog :is(button, a):focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }
  .mdx-reference-dialog {
    box-sizing: border-box;
    width: min(72rem, calc(100vw - 2rem));
    max-width: calc(100vw - 1rem);
    max-height: calc(100dvh - 2rem);
    padding: clamp(0.75rem, 2vw, 1.25rem);
    border: 1px solid var(--color-antique-gold);
    border-radius: var(--radius-card);
    background: var(--color-parchment);
    color: var(--color-charcoal);
    overflow: auto;
    font-family: var(--font-interface), sans-serif;
    font-size: var(--text-ui);
    line-height: 1.5;
  }
  .mdx-reference-dialog::backdrop { background: rgba(0, 0, 0, 0.8); }
  .mdx-reference-dialog__toolbar { display: flex; justify-content: flex-end; }
  .mdx-reference-dialog__close {
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--color-antique-gold);
    border-radius: var(--radius-control);
    background: var(--color-aged-paper);
    color: var(--color-charcoal);
    cursor: pointer;
  }
  .mdx-reference-dialog__image {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 65dvh;
    margin: 0.75rem auto;
    object-fit: contain;
  }
  .mdx-reference-dialog__caption {
    margin: 0.75rem 0 0.4rem;
    font-family: var(--font-reading), serif;
  }
  .mdx-reference-dialog__original {
    color: var(--color-oxide-red);
    text-decoration: underline;
    text-underline-offset: 0.17em;
  }
  /*
   * The middle desktop width can use more of the viewport. On mobile the
   * image stays in the article measure; at 1440+ it does not collide with
   * the sticky contents rail or contextual sidebar.
   */
  @media (min-width: 1024px) and (max-width: 1439px) {
    .mdx-figure--wide {
      --figure-wide-width: min(960px, calc(100vw - var(--spacing-gutter) - var(--spacing-gutter)));
      width: var(--figure-wide-width);
      max-width: none;
      margin-inline-start: calc((100% - var(--figure-wide-width)) / 2);
    }
  }
  @media print {
    .mdx-figure {
      width: 100%;
      max-width: 100%;
      margin-inline: 0;
      border-color: currentColor;
      background: transparent;
    }
    .mdx-figure__caption { color: black; }
    .mdx-figure__caption a { color: inherit; }
  }
</style>

<script>
  // Native showModal handles focus containment, inert background and Escape.
  // No-JS readers still see the reference and its original-image link.
  function initReferenceLightboxes() {
    // Do not expose a control if native modal dialogs are unsupported.
    if (typeof HTMLDialogElement === "undefined" ||
        typeof HTMLDialogElement.prototype.showModal !== "function") return;
    for (const trigger of document.querySelectorAll<HTMLButtonElement>("[data-reference-lightbox-open]")) {
      if (trigger.dataset.lightboxReady === "true") continue;
      const dialog = trigger.closest("figure")?.nextElementSibling;
      if (!(dialog instanceof HTMLDialogElement) || !dialog.matches("[data-reference-lightbox]")) continue;
      const close = dialog.querySelector<HTMLButtonElement>("[data-reference-lightbox-close]");
      if (!close) continue;
      trigger.dataset.lightboxReady = "true";
      trigger.hidden = false;
      const originalImage = dialog.querySelector<HTMLImageElement>(".mdx-reference-dialog__image");
      const openDialog = () => {
        if (!dialog.open) {
          // Fetch the full-resolution asset only on explicit inspection.
          if (originalImage) originalImage.loading = "eager";
          dialog.showModal();
          close.focus();
        }
      };
      trigger.addEventListener("click", openDialog);
      // Native button activation remains available; handle keyboard presses
      // explicitly so focus transfer cannot race a later synthetic click.
      trigger.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          if (!event.repeat) openDialog();
        }
      });
      close.addEventListener("click", () => dialog.close());
      // Native modal focus containment is the baseline. Also wrap between
      // these two controls explicitly for browser/keyboard edge cases.
      const originalLink = dialog.querySelector<HTMLAnchorElement>(".mdx-reference-dialog__original");
      dialog.addEventListener("keydown", (event) => {
        if (event.key !== "Tab" || !originalLink) return;
        if (event.shiftKey && document.activeElement === close) {
          event.preventDefault();
          originalLink.focus();
        } else if (!event.shiftKey && document.activeElement === originalLink) {
          event.preventDefault();
          close.focus();
        }
      });
      dialog.addEventListener("close", () => {
        if (trigger.isConnected) trigger.focus({ preventScroll: true });
      });
    }
  }
  document.addEventListener("astro:page-load", initReferenceLightboxes);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initReferenceLightboxes, { once: true });
  } else {
    initReferenceLightboxes();
  }
</script>
