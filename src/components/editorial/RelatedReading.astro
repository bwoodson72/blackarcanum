---
import { articlePath } from "../../lib/editorial-presentation";
import type { PublishedArticleView } from "../../lib/editorial-presentation";

interface Props {
  article: PublishedArticleView;
  variant?: "compact" | "card";
}

const { article, variant = "compact" } = Astro.props;
// Canonical local destinations only, never arbitrary external URLs.
const href = articlePath(article.collection, article.id);
const sectionLabel = article.collection === "library" ? "Library · Research" : "Grimoire · Practice";
---

<article class:list={["related-reading", `related-reading--${variant}`]}>
  <p class="related-reading__eyebrow">
    <span>{sectionLabel}</span>
    {article.preview && <span class="related-reading__preview"> · Layout preview</span>}
  </p>
  <h3 class="related-reading__title">
    <a href={href}>{article.title}<span aria-hidden="true" class="related-reading__arrow">→</span></a>
  </h3>
  {variant === "card" && article.excerpt?.trim() && (
    <p class="related-reading__excerpt">{article.excerpt}</p>
  )}
</article>

<style>
  .related-reading {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .related-reading__eyebrow {
    margin: 0 0 0.4rem;
    color: var(--color-sage-ink);
    font-family: var(--font-interface);
    font-size: var(--text-ui);
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: 0.065em;
    text-transform: uppercase;
  }
  .related-reading__preview {
    color: var(--color-muted-ink);
    font-weight: 500;
  }
  .related-reading__title {
    margin: 0;
    color: var(--color-charcoal);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.15rem + 0.8vw, 1.75rem);
    font-weight: 600;
    line-height: 1.17;
  }
  .related-reading__title a {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.2em;
  }
  .related-reading__title a:hover {
    color: var(--color-oxide-red);
    text-decoration: underline;
  }
  .related-reading__title a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
    border-radius: var(--radius-control);
  }
  .related-reading__arrow {
    display: inline;
    margin-inline-start: 0.45rem;
    color: var(--color-oxide-red);
    white-space: nowrap;
  }
  .related-reading--card {
    height: 100%;
    padding: clamp(1rem, 2.3vw, 1.5rem);
    border: 1px solid var(--color-border-paper);
    border-top: 3px solid var(--color-antique-gold);
    background: var(--color-aged-paper);
  }
  .related-reading__excerpt {
    margin: 0.75rem 0 0;
    color: var(--color-muted-ink);
    font-family: var(--font-reading);
    font-size: var(--text-body);
    line-height: 1.55;
  }
  @media print {
    .related-reading--card {
      background: transparent;
      border-color: currentColor;
      break-inside: avoid;
    }
  }
</style>
