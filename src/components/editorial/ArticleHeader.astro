---
import ArticleMetadata from "./ArticleMetadata.astro";
import type { PublishedArticleView } from "../../lib/editorial-presentation";

interface Props {
  article: PublishedArticleView;
}

const { article } = Astro.props;
const hero = article.image?.src?.trim() && article.image.alt?.trim()
  ? article.image
  : undefined;
const lead = article.excerpt?.trim();
const sectionLabel = article.collection === "library"
  ? "Research · The Library"
  : "Practice · The Grimoire";
---

<header class:list={["article-header", `article-header--${article.collection}`]}>
  <p class="article-header__eyebrow">{sectionLabel}</p>
  {article.preview && (
    <p class="article-header__preview">LAYOUT PREVIEW <span aria-hidden="true">·</span> Temporary sample content for design review, not a finished article.</p>
  )}
  <h1 id="article-title">{article.title}</h1>
  {lead && <p class="article-header__lead">{lead}</p>}
  <ArticleMetadata
    collection={article.collection}
    publishedAt={article.publishedAt}
    updatedAt={article.updatedAt}
  />
  {hero && (
    <figure class="article-header__hero">
      <img
        src={hero.src}
        alt={hero.alt}
        width="1200"
        height="800"
        loading="eager"
        decoding="async"
      />
    </figure>
  )}
</header>

<style>
  .article-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.75rem, 1.7vw, 1.25rem);
    min-width: 0;
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--color-border-paper);
  }
  .article-header__eyebrow {
    margin: 0;
    font-family: var(--font-interface);
    font-size: var(--text-ui);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--color-sage-ink);
  }
  .article-header--grimoire .article-header__eyebrow {
    color: var(--color-oxide-red);
  }
  .article-header__preview {
    margin: 0;
    max-width: 58ch;
    padding: 0.65rem 0.85rem;
    border-left: 3px solid var(--color-antique-gold);
    background: var(--color-aged-paper);
    color: var(--color-charcoal);
    font-family: var(--font-interface);
    font-size: var(--text-ui);
    line-height: 1.55;
  }
  .article-header h1 {
    margin: 0;
    max-width: 24ch;
    color: var(--color-charcoal);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.75rem + 2.2vw, 3.5rem);
    font-weight: 600;
    line-height: 1.07;
    overflow-wrap: anywhere;
  }
  .article-header__lead {
    margin: 0;
    max-width: 60ch;
    color: var(--color-charcoal);
    font-family: var(--font-reading);
    font-size: var(--text-lead);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .article-header__hero {
    display: block;
    align-self: stretch;
    width: 100%;
    margin: clamp(0.5rem, 1.5vw, 1rem) 0 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--color-border-paper);
    border-radius: var(--radius-card);
    background: var(--color-aged-paper);
  }
  .article-header--grimoire .article-header__hero {
    border-color: var(--color-antique-gold);
  }
  .article-header__hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
