---
import Container from "../foundation/Container.astro";
import CelestialDivider from "../foundation/CelestialDivider.astro";
import EngravedFrame from "../foundation/EngravedFrame.astro";
import "../../styles/archive-hero.css";

type Collection = "library" | "grimoire";
interface Props { collection: Collection; }
const { collection } = Astro.props;
if (collection !== "library" && collection !== "grimoire") {
  throw new Error("ArchiveHero supports Library and Grimoire only.");
}
const isLibrary = collection === "library";
const title = isLibrary ? "The Library" : "The Grimoire";
const tagline = isLibrary
  ? ["Historical Sources", "Academic Research", "Cultural Context"]
  : ["Ritual Practice", "Techniques", "Personal Work"];
const description = isLibrary
  ? "Historical texts, esoteric traditions, and the ideas that travel between them—explored through sources, context, and careful interpretation."
  : "An editorial space for original methods, adaptations, experiments, and practitioner observations—where what was done is distinguished from what it might mean.";
const listTarget = isLibrary ? "#library-listing-heading" : "#grimoire-list-heading";
---
<header class:list={["archive-hero", isLibrary ? "library-hero" : "grimoire-hero"]} data-archive-hero={collection}>
  <div class="archive-hero__art" aria-hidden="true">
    <svg class="archive-hero__image" viewBox="0 0 2000 800" preserveAspectRatio="xMidYMid slice" focusable="false" aria-hidden="true">
      <image href="/images/homepage/mystagogia-editorial-atlas.avif" x="0" y="0" width="2000" height="1056" />
    </svg>
  </div>
  <Container width="full" class="archive-hero__inner">
    <div class="archive-hero__copy">
      <CelestialDivider />
      <h1>{title}</h1>
      <p class="archive-hero__tagline">
        {tagline.map((part, index) => (
          <><span>{part}</span>{index < tagline.length - 1 && <span aria-hidden="true"> · </span>}</>
        ))}
      </p>
      <p class="archive-hero__lead">{description}</p>
      <a class="archive-hero__action" href={listTarget}>
        <span>Browse {title}</span>
        <span class="archive-hero__arrow" aria-hidden="true">→</span>
        <EngravedFrame />
      </a>
    </div>
  </Container>
</header>
