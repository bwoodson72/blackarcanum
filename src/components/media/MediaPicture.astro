---
import { Image, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getMediaDisplayPlan } from "../../lib/media-display";
import type { MediaDisplayVariant } from "../../lib/media-display";

interface Props {
  /** Already resolved by MediaImage from the approved local registry. */
  asset: ImageMetadata;
  alt: string;
  variant: MediaDisplayVariant;
  /** Only true for a primary, above-the-fold hero. */
  priority?: boolean;
  sizes?: string;
  class?: string;
}

const {
  asset,
  alt,
  variant,
  priority = variant === "hero",
  sizes,
  class: className,
} = Astro.props;

if (variant === "decorative" ? alt !== "" : !alt.trim()) {
  throw new Error("MediaPicture requires meaningful alt, except for decorative images with alt=\"\".");
}

const plan = getMediaDisplayPlan(asset, variant, priority);
const isSvg = asset.format === "svg";
const isReference = variant === "reference";
// Preserve original encoding for SVG and research figures. For photos,
// Astro generates modern AVIF/WebP sources with original-format fallback.
const fallbackFormat = asset.format === "jpg" ? "jpeg" : asset.format;
---

<div
  class:list={["media-picture", `media-picture--${variant}`, className]}
  data-media-variant={variant}
  aria-hidden={variant === "decorative" ? "true" : undefined}
>
  {isSvg ? (
    <Image
      src={asset}
      alt={alt}
      width={asset.width}
      height={asset.height}
      loading={priority ? "eager" : "lazy"}
      decoding={priority ? "sync" : "async"}
      fetchpriority={priority ? "high" : "auto"}
    />
  ) : isReference ? (
    <Image
      src={asset}
      alt={alt}
      format={fallbackFormat}
      layout="constrained"
      width={plan.displayWidth}
      widths={plan.widths}
      sizes={sizes ?? plan.sizes}
      fit="contain"
      loading={priority ? "eager" : "lazy"}
      decoding={priority ? "sync" : "async"}
      fetchpriority={priority ? "high" : "auto"}
    />
  ) : (
    <Picture
      src={asset}
      alt={alt}
      formats={["avif", "webp"]}
      fallbackFormat={fallbackFormat}
      layout="constrained"
      width={plan.displayWidth}
      widths={plan.widths}
      sizes={sizes ?? plan.sizes}
      fit={plan.preserveFullImage ? "contain" : "cover"}
      loading={priority ? "eager" : "lazy"}
      decoding={priority ? "sync" : "async"}
      fetchpriority={priority ? "high" : "auto"}
    />
  )}
</div>

<style>
  .media-picture {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    line-height: 0;
  }
  .media-picture :global(picture) {
    display: block;
    width: 100%;
    max-width: 100%;
  }
  .media-picture :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-position: center;
  }
  .media-picture--card {
    aspect-ratio: 3 / 2;
    background: var(--color-aged-paper);
  }
  .media-picture--card :global(picture),
  .media-picture--card :global(img) {
    width: 100%;
    height: 100%;
  }
  .media-picture--card :global(img) { object-fit: cover; }
  .media-picture--hero :global(img),
  .media-picture--reference :global(img),
  .media-picture--decorative :global(img) {
    object-fit: contain;
  }
  /* A scholarly reference never inherits a card/hero crop or fixed height. */
  .media-picture--reference { aspect-ratio: auto; }
</style>
