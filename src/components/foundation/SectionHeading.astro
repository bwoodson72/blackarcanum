---
import Ornament from "./Ornament.astro";

type Level = "h1" | "h2" | "h3";
type Alignment = "start" | "center";

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  /** Optional section title ID for aria-labelledby links. */
  id?: string;
  as?: Level;
  align?: Alignment;
  ornament?: boolean;
  class?: string;
}

const {
  title,
  eyebrow,
  description,
  id,
  as = "h2",
  align = "start",
  ornament = false,
  class: className,
} = Astro.props;
const Heading = as;
---

<div class:list={["section-heading", `section-heading--${align}`, className]}>
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <Heading id={id} class="section-heading__title">{title}</Heading>
  {ornament && <Ornament variant="rule" />}
  {description && <p class="section-heading__description">{description}</p>}
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
    max-width: 100%;
  }

  .section-heading--center {
    text-align: center;
    align-items: center;
  }

  .section-heading__eyebrow {
    color: var(--text-muted);
    font-family: var(--font-interface);
    font-size: var(--text-ui);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-heading__title {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 600;
    line-height: 1.12;
    overflow-wrap: anywhere;
  }

  .section-heading__description {
    max-width: var(--container-reading);
    color: var(--text-muted);
    font-family: var(--font-reading);
    font-size: var(--text-body);
    line-height: 1.7;
  }
</style>
