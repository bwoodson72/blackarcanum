---
import BaseLayout from "./BaseLayout.astro";
import { getImage } from "astro:assets";
import { getMediaRecord, mediaPublicationIssues } from "../lib/media-registry";
import { media } from "../data/media";
import { resolveMediaAsset } from "../lib/media-assets";
import ArticleHeader from "../components/editorial/ArticleHeader.astro";
import ArticleTableOfContents from "../components/editorial/ArticleTableOfContents.astro";
import ArticleReferences from "../components/editorial/ArticleReferences.astro";
import RelatedArticles from "../components/editorial/RelatedArticles.astro";
import type { Citation } from "../lib/editorial-citations";
import { getArticleTableOfContents } from "../lib/article-toc";
import type { ArticleHeading } from "../lib/article-toc";
import type { PublishedArticleView } from "../lib/editorial-presentation";
import type { BreadcrumbTrail } from "../components/site/Breadcrumbs.astro";
import "../styles/article-reading.css";
import "../styles/mdx-text-blocks.css";
import "../styles/mdx-multi-image.css";

interface Props {
  /** Already publication-gated and validated before entering the layout. */
  article: PublishedArticleView;
  /** Passed verbatim from Astro MDX render(entry).headings. */
  headings: readonly ArticleHeading[];
  /** Source-backed citation occurrences and optional uncited bibliography. */
  citations?: readonly Citation[];
  sourceIds?: readonly string[];
  /** Resolved, explicitly curated published links, never generated matches. */
  relatedArticles?: readonly PublishedArticleView[];
  relatedVariant?: "compact" | "cards";
}
const {
  article,
  headings,
  citations = [],
  sourceIds = [],
  relatedArticles = [],
  relatedVariant = "compact",
} = Astro.props;
const sectionLabel = article.collection === "library" ? "Library" : "Grimoire";
const sectionHref = article.collection === "library" ? "/library/" : "/grimoire/";
const breadcrumbs: BreadcrumbTrail = [
  { label: "Home", href: "/" },
  { label: sectionLabel, href: sectionHref },
  { label: article.title },
];
const tocEntries = getArticleTableOfContents(headings);
const hasToc = tocEntries.length > 0;
const hasContext = Astro.slots.has("context");
let socialImage: string | undefined;
// A legacy hero path is not automatically a rights-cleared social asset.
// Only attach explicitly approved, publication-cleared article artwork.
// Do not reuse the Tyche image as an unrelated site's generic OG image.
if (Astro.site && !article.preview && article.mediaId) {
  const record = getMediaRecord(article.mediaId, media);
  const issues = mediaPublicationIssues(record);
  if (issues.length) throw new Error("Uncleared OG image: " + issues.join("; "));
  const optimized = await getImage({
    src: resolveMediaAsset(record),
    width: 1200,
    format: "webp",
  });
  socialImage = optimized.src;
}
---

<BaseLayout
  title={article.title}
  description={article.excerpt ?? article.title}
  image={socialImage}
  noindex={article.preview === true}
  article={article.publishedAt ? { publishedAt: article.publishedAt, updatedAt: article.updatedAt } : undefined}
  breadcrumbs={breadcrumbs}
>
  <div class:list={["article-reading", `article-reading--${article.collection}`]}>
    <div class="article-reading__grid">
      {hasToc && (
        <aside class="article-reading__toc" aria-label="On this page">
          <ArticleTableOfContents entries={tocEntries} variant="rail" />
        </aside>
      )}

      <article class="article-reading__article" aria-labelledby="article-title" data-pagefind-body={article.preview ? undefined : ""}
        data-pagefind-filter={article.preview ? undefined : "collection:" + article.collection}>
        <ArticleHeader article={article} />
        {hasToc && (
          <div class="article-reading__mobile-toc" data-pagefind-ignore>
            <ArticleTableOfContents entries={tocEntries} variant="disclosure" />
          </div>
        )}
        <div class="article-reading__content reading-content" data-reading-content>
          <slot />
        </div>
        <div data-pagefind-ignore>
          <ArticleReferences citations={citations} sourceIds={sourceIds} />
          <RelatedArticles articles={relatedArticles} variant={relatedVariant} />
        </div>
        <footer class="article-reading__footer" data-pagefind-ignore>
          <a href={sectionHref}>
            <span aria-hidden="true">←</span> All {sectionLabel} entries
          </a>
        </footer>
      </article>

      {hasContext && (
        <aside class="article-reading__context" aria-label="Additional reading">
          <slot name="context" />
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
