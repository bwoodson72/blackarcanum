---
import BaseLayout from "./BaseLayout.astro";
import ArticleHeader from "../components/editorial/ArticleHeader.astro";
import ArticleTableOfContents from "../components/editorial/ArticleTableOfContents.astro";
import { getArticleTableOfContents } from "../lib/article-toc";
import type { ArticleHeading } from "../lib/article-toc";
import type { PublishedArticleView } from "../lib/editorial-presentation";
import type { BreadcrumbTrail } from "../components/site/Breadcrumbs.astro";
import "../styles/article-reading.css";

interface Props {
  /** Already publication-gated and validated before entering the layout. */
  article: PublishedArticleView;
  /** Passed verbatim from Astro MDX render(entry).headings. */
  headings: readonly ArticleHeading[];
}
const { article, headings } = Astro.props;
const sectionLabel = article.collection === "library" ? "Library" : "Grimoire";
const sectionHref = article.collection === "library" ? "/library/" : "/grimoire/";
const breadcrumbs: BreadcrumbTrail = [
  { label: "Home", href: "/" },
  { label: sectionLabel, href: sectionHref },
  { label: article.title },
];
const tocEntries = getArticleTableOfContents(headings);
const hasToc = tocEntries.length > 0;
const hasContext = Astro.slots.has("context");
---

<BaseLayout
  title={article.title}
  description={article.excerpt ?? article.title}
  image={article.image?.src}
  breadcrumbs={breadcrumbs}
>
  <div class:list={["article-reading", `article-reading--${article.collection}`]}>
    <div class="article-reading__grid">
      {hasToc && (
        <aside class="article-reading__toc" aria-label="On this page">
          <ArticleTableOfContents entries={tocEntries} variant="rail" />
        </aside>
      )}

      <article class="article-reading__article" aria-labelledby="article-title">
        <ArticleHeader article={article} />
        {hasToc && (
          <div class="article-reading__mobile-toc">
            <ArticleTableOfContents entries={tocEntries} variant="disclosure" />
          </div>
        )}
        <div class="article-reading__content reading-content" data-reading-content>
          <slot />
        </div>
        <footer class="article-reading__footer">
          <a href={sectionHref}>
            <span aria-hidden="true">←</span> All {sectionLabel} entries
          </a>
        </footer>
      </article>

      {hasContext && (
        <aside class="article-reading__context" aria-label="Additional reading">
          <slot name="context" />
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
